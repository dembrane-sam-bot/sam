# Slack
SLACK_APP_TOKEN=xapp-...           # Socket Mode connection
SLACK_BOT_TOKEN=xoxb-...           # Bot user OAuth token
SLACK_SIGNING_SECRET=...           # For request verification

# GitHub
GITHUB_TOKEN=github_pat_...        # Fine-grained PAT, scoped to Dembrane repos

# Linear
LINEAR_API_KEY=lin_api_...

# Google Cloud / Vertex AI (required for ADK runner)
GOOGLE_CLOUD_PROJECT=...           # GCP project ID
GOOGLE_CLOUD_LOCATION=eu           # Used ONLY by the dormant Claude path.
                                   # Gemini agents pin location per-agent via
                                   # SAM_MAIN_VERTEX_LOCATION / SAM_WORKER_VERTEX_LOCATION
                                   # in src/runtime/config.py (main on "global" for
                                   # Gemini 3.x preview, workers on "eu" for residency).
                                   # If you flip SAM_MAIN_MODEL back to claude-*, this
                                   # env var becomes load-bearing again — keep it "eu".
# Auth: run `gcloud auth application-default login` on the host. The
# compose.yml bind-mounts ~/.config/gcloud into the container; no service
# account key file needed locally. On GCP, use workload identity instead.

# Sam
SAM_HOME=/data                     # Inside-container path for journal, lockfile, repos
SAM_CHANNEL=C...                   # Slack channel ID where Sam lives
SAM_OPERATOR_USER_ID=U...          # @-mentioned by the daemon when both attempts at a session fail
TZ=Europe/Amsterdam