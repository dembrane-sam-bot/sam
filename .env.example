# Slack
SLACK_APP_TOKEN=xapp-...           # Socket Mode connection
SLACK_BOT_TOKEN=xoxb-...           # Bot user OAuth token
SLACK_SIGNING_SECRET=...           # For request verification

# GitHub
GITHUB_TOKEN=github_pat_...        # Fine-grained PAT, scoped to Dembrane repos

# Linear
LINEAR_API_KEY=lin_api_...

# Google Cloud / Vertex AI (required for ADK runner)
GOOGLE_CLOUD_PROJECT=...           # GCP project ID
GOOGLE_CLOUD_LOCATION=us-central1  # Vertex AI region
GOOGLE_APPLICATION_CREDENTIALS=... # Path to service account JSON key file
                                   # (omit if using workload identity / ADC)

# Sam
SAM_HOME=/data                     # Inside-container path for journal, lockfile, repos
SAM_CHANNEL=C...                   # Slack channel ID where Sam lives
SAM_OPERATOR_USER_ID=U...          # @-mentioned by the daemon when both attempts at a session fail
TZ=Europe/Amsterdam